<?php

function converterTemperatura($valor, $origem, $destino) {

    if ($origem == "C") {
        $celsius = $valor;
    } elseif ($origem == "F") {
        $celsius = ($valor - 32) * 5 / 9;
    } elseif ($origem == "K") {
        $celsius = $valor - 273.15;
    }

    if ($destino == "C") {
        return $celsius;
    } elseif ($destino == "F") {
        return ($celsius * 9 / 5) + 32;
    } elseif ($destino == "K") {
        return $celsius + 273.15;
    }
}

$valor = 25;
$origem = "C";
$destino = "F";

$resultado = converterTemperatura($valor, $origem, $destino);

echo "Temperatura convertida: " . $resultado . "°" . $destino;

?>