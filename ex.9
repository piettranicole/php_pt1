<?php

function analisarNumero($numero) {
    if ($numero % 2 == 0) {
        $paridade = "par";
    } else {
        $paridade = "ímpar";
    }

    $primo = true;

    if ($numero < 2) {
        $primo = false;
    } else {
        for ($i = 2; $i < $numero; $i++) {
            if ($numero % $i == 0) {
                $primo = false;
                break;
            }
        }
    }

    $soma = 0;

    for ($i = 1; $i < $numero; $i++) {
        if ($numero % $i == 0) {
            $soma += $i;
        }
    }

    if ($soma == $numero && $numero > 0) {
        $perfeito = "sim";
    } else {
        $perfeito = "não";
    }

    return [
        "paridade" => $paridade,
        "primo" => $primo ? "sim" : "não",
        "perfeito" => $perfeito
    ];
}

$numero = 28;

$resultado = analisarNumero($numero);

echo "número: " . $numero . "<br>";
echo "par ou ímpar: " . $resultado["paridade"] . "<br>";
echo "primo: " . $resultado["primo"] . "<br>";
echo "perfeito: " . $resultado["perfeito"];

?>